# ============================================
# 部署环境变量配置
# 使用方式：复制为 .env 后按实际值修改，再执行 docker compose up -d
# ============================================

# ---------- 对外访问地址（重要）----------
# 有域名填 http://your-domain.com，无域名填 http://服务器公网IP
# 桌台二维码中会写入该地址，配错会导致扫码打不开
APP_DOMAIN=http://127.0.0.1

# 应用对外端口（默认 8080）
APP_PORT=8080

# ---------- MySQL ----------
MYSQL_DATABASE=reggie
# !!! 生产环境务必修改为强密码 !!!
MYSQL_PASSWORD=***

# ---------- Redis ----------
# !!! 生产环境务必修改为强密码 !!!
# 注意：此变量不可留空（不能写成 REDIS_PASSWORD=），否则会触发配置解析异常
REDIS_PASSWORD=***

# ---------- 安全密钥 ----------
# Cookie 签名密钥，至少 32 位随机字符串
# 生成方式：openssl rand -hex 32
REMEMBER_KEY=ChangeMe_Please_Use_Random_32_Chars_String

# ---------- 邮箱验证码（QQ 邮箱）----------
# 发件邮箱地址
MAIL_USER=2771464100@qq.com
# QQ 邮箱 SMTP 授权码（非登录密码），在 QQ 邮箱设置-账户中开启 SMTP 获取
MAIL_PASSWORD=***
